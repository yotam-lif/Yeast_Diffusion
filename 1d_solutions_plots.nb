Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Load", " ", "the", " ", "finite", " ", "element", " ", "package"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Needs", "[", "\"\<NDSolve`FEM`\>\"", "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "parameters"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"omega", "=", "1"}], ";"}], "    ", 
   RowBox[{"(*", 
    RowBox[{
    "Replace", " ", "with", " ", "your", " ", "desired", " ", "value"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"r", "=", "1"}], ";"}], "        ", 
   RowBox[{"(*", 
    RowBox[{
    "Replace", " ", "with", " ", "your", " ", "desired", " ", "value"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"xMax", "=", "20"}], ";"}], "    ", 
   RowBox[{"(*", 
    RowBox[{"Set", " ", "the", " ", "maximum", " ", "x", " ", "value"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"zMax", "=", "10"}], ";"}], "    ", 
   RowBox[{"(*", 
    RowBox[{"Set", " ", "the", " ", "maximum", " ", "z", " ", "value"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"LD", "=", 
     RowBox[{"1", "/", "omega"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "computational", " ", "domain"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"region", "=", 
     RowBox[{"Rectangle", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "xMax"}], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"xMax", ",", "zMax"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "PDE", " ", "with", " ", "NeumannValue", " ", 
     "terms", " ", "included"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pde", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Laplacian", "[", 
         RowBox[{
          RowBox[{"C", "[", 
           RowBox[{"x", ",", "z"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "z"}], "}"}]}], "]"}]}], "+", 
       RowBox[{"NeumannValue", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"omega", "*", 
           RowBox[{"C", "[", 
            RowBox[{"x", ",", "z"}], "]"}]}], "-", 
          RowBox[{"r", "*", 
           RowBox[{"UnitStep", "[", 
            RowBox[{"-", "x"}], "]"}]}]}], ",", 
         RowBox[{"z", "==", "0"}]}], "]"}], "+", 
       RowBox[{"NeumannValue", "[", 
        RowBox[{"0", ",", 
         RowBox[{
          RowBox[{"x", "==", 
           RowBox[{"-", "xMax"}]}], "||", 
          RowBox[{"x", "==", "xMax"}], "||", 
          RowBox[{"z", "==", "zMax"}]}]}], "]"}]}], "==", "0"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Increase", " ", "spatial", " ", "resolution", " ", "by", " ", "refining",
      " ", "the", " ", "mesh"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"meshOptions", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<MaxCellMeasure\>\"", "->", "0.001"}], "}"}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{
    "Further", " ", "decrease", " ", "for", " ", "finer", " ", "mesh"}], 
    "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "Analytical", " ", "Solutions"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"CAnalytical", "[", "x_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"nMax", "=", "150"}], ",", 
         RowBox[{"sum", "=", "0"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"sum", "=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"kn", "=", 
               RowBox[{"Pi", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", " ", "n"}], "+", "1"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"2", " ", "xMax"}], ")"}]}]}]}], "}"}], ",", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Sin", "[", 
                 RowBox[{"kn", " ", "x"}], "]"}], " ", 
                RowBox[{"Cosh", "[", 
                 RowBox[{"kn", " ", "zMax"}], "]"}]}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"kn", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"kn", " ", 
                   RowBox[{"Sinh", "[", 
                    RowBox[{"kn", " ", "zMax"}], "]"}]}], "+", 
                  RowBox[{"omega", " ", 
                   RowBox[{"Cosh", "[", 
                    RowBox[{"kn", " ", "zMax"}], "]"}]}]}], ")"}]}], 
               ")"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "0", ",", "nMax"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r", "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "omega"}], ")"}]}], ")"}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r", "/", "xMax"}], ")"}], " ", "sum"}]}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"CAnalyticApprox", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "/", "omega"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"HeavisideTheta", "[", 
         RowBox[{"-", "x"}], "]"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"x", "/", "LD"}], "]"}], "/", "\[Pi]"}], ")"}], " ", 
         RowBox[{"Sign", "[", "x", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], "-", 
           RowBox[{"SinIntegral", "[", 
            RowBox[{
             RowBox[{"Abs", "[", "x", "]"}], "/", "LD"}], "]"}]}], ")"}]}], 
        "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"x", "/", "LD"}], "]"}], "/", "\[Pi]"}], ")"}], " ", 
         RowBox[{"CosIntegral", "[", 
          RowBox[{
           RowBox[{"Abs", "[", "x", "]"}], "/", "LD"}], "]"}]}]}], ")"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"CAnalyticlFF", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "/", "omega"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"HeavisideTheta", "[", 
         RowBox[{"-", "x"}], "]"}], "+", 
        RowBox[{"LD", "/", 
         RowBox[{"(", 
          RowBox[{"\[Pi]", " ", "x"}], ")"}]}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"CAnalyticlNF", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "/", 
        RowBox[{"(", 
         RowBox[{"\[Pi]", " ", "omega"}], ")"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"HeavisideTheta", "[", 
         RowBox[{"-", "x"}], "]"}], "+", 
        RowBox[{
         RowBox[{"Sign", "[", "x", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], "-", 
           RowBox[{"(", 
            RowBox[{"x", "/", "LD"}], ")"}]}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "/", "LD"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Log", "[", 
            RowBox[{
             RowBox[{"Abs", "[", "x", "]"}], "/", "LD"}], "]"}], "+", 
           "EulerGamma"}], ")"}]}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
