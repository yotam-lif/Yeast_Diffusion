Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Generate", " ", "x"}], "-", 
     RowBox[{
     "values", " ", "with", " ", "higher", " ", "density", " ", "near", " ", 
      "x"}]}], "=", 
    RowBox[{"0", " ", "using", " ", "a", " ", "Gaussian", " ", "function"}]}],
    "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"First", " ", "set", " ", "of", " ", "x"}], "-", "values"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"n1", "=", "60"}], ";"}], "                ", 
   RowBox[{"(*", 
    RowBox[{
    "Total", " ", "number", " ", "of", " ", "points", " ", "for", " ", "the", 
     " ", "first", " ", "set"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"sigma1", "=", "xMax"}], ";"}], "         ", 
   RowBox[{"(*", 
    RowBox[{
    "Standard", " ", "deviation", " ", "for", " ", "the", " ", "first", " ", 
     "set"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"uList1", "=", 
     RowBox[{"Subdivide", "[", 
      RowBox[{"0.001", ",", "0.999", ",", "n1"}], "]"}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{
    "Avoid", " ", "extremes", " ", "at", " ", "0", " ", "and", " ", "1"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"xList1", "=", 
     RowBox[{"InverseCDF", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", "sigma1"}], "]"}], ",", "uList1"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"xList1", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"xList1", ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"-", "xMax"}], "<=", "#", "<=", "xMax"}], "&&", 
         RowBox[{
          RowBox[{"Abs", "[", "#", "]"}], ">", 
          RowBox[{"10", "^", 
           RowBox[{"-", "8"}]}]}]}], "&"}]}], "]"}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Limit", " ", 
      RowBox[{"to", "[", 
       RowBox[{
        RowBox[{"-", "xMax"}], ",", "xMax"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"exclude", " ", "x"}], "=", "0"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"xList1", "=", 
     RowBox[{"Sort", "[", "xList1", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Second", " ", "set", " ", "of", " ", "x"}], "-", "values"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"n2", "=", "40"}], ";"}], "                ", 
   RowBox[{"(*", 
    RowBox[{
    "Total", " ", "number", " ", "of", " ", "points", " ", "for", " ", "the", 
     " ", "second", " ", "set"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"sigma2", "=", 
     RowBox[{"xMax", "/", "10"}]}], ";"}], "         ", 
   RowBox[{"(*", 
    RowBox[{
    "Standard", " ", "deviation", " ", "for", " ", "the", " ", "second", " ", 
     "set"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"uList2", "=", 
     RowBox[{"Subdivide", "[", 
      RowBox[{"0.00001", ",", "0.999", ",", "n2"}], "]"}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{
    "Avoid", " ", "extremes", " ", "at", " ", "0", " ", "and", " ", "1"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"xList2", "=", 
     RowBox[{"InverseCDF", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", "sigma2"}], "]"}], ",", "uList2"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"xList2", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"xList2", ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"-", "xMax"}], "<=", "#", "<=", "xMax"}], "&&", 
         RowBox[{
          RowBox[{"Abs", "[", "#", "]"}], ">", 
          RowBox[{"10", "^", 
           RowBox[{"-", "8"}]}]}]}], "&"}]}], "]"}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Limit", " ", 
      RowBox[{"to", "[", 
       RowBox[{
        RowBox[{"-", "xMax"}], ",", "xMax"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"exclude", " ", "x"}], "=", "0"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"xList2", "=", 
