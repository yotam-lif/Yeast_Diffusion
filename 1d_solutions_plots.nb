     RowBox[{"Subdivide", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "xMax"}], "/", "5"}], ",", "0", ",", "200"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]"}]}]], "Input",
