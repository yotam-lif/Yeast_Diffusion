Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Begin"}]}], " ", "Additional", " ", "Code", " ", "for", 
     " ", "Bar1", " ", "and", " ", 
     RowBox[{"Bar1", "'"}], " ", 
     RowBox[{"Plot", "--"}]}], "-"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Define", " ", 
    RowBox[{"Bar1", "[", "x", "]"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Bar1", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"HeavisideTheta", "[", 
      RowBox[{"-", "x"}], "]"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "*", 
        RowBox[{"CAnalytical", "[", "x", "]"}]}], "-", 
       RowBox[{"r", "/", "omega"}]}], ")"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"\[Lambda]a", " ", ":=", " ", 
    RowBox[{"1", "/", "LD"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "S18", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"|", "x", "|"}], " ", ">>", 
       RowBox[{"\[Lambda]a", " ", "limit"}]}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"S18", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "/", "omega"}], ")"}], "*", 
      RowBox[{"HeavisideTheta", "[", 
       RowBox[{"-", "x"}], "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"2", 
         RowBox[{"\[Lambda]a", "/", 
          RowBox[{"(", 
           RowBox[{"Pi", "*", "x"}], ")"}]}]}]}], ")"}]}], " ", "+", " ", 
     "0.01"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "S19", " ", 
     RowBox[{"(", 
      RowBox[{"|", "x", "|", 
       RowBox[{
        RowBox[{"<<", "\[Lambda]a"}], " ", "limit"}]}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"S19", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"r", "/", "omega"}], ")"}], "*", 
     RowBox[{"HeavisideTheta", "[", 
      RowBox[{"-", "x"}], "]"}], "*", 
     RowBox[{"(", 
      RowBox[{"2", 
       RowBox[{"x", "/", 
        RowBox[{"(", 
         RowBox[{"Pi", "*", "\[Lambda]a"}], ")"}]}]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{
         RowBox[{"Abs", "[", "x", "]"}], "/", "\[Lambda]a"}], "]"}], "+", 
       "EulerGamma", "-", "1"}], ")"}]}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Generate", " ", "x"}], "-", 
     RowBox[{"values", " ", "for", " ", "Bar1", " ", "and", " ", 
      RowBox[{"Bar1", "'"}], " ", "with", " ", "high", " ", "resolution"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xListBar", "=", 
     RowBox[{"Subdivide", "[", 
      RowBox[{
       RowBox[{"-", "xMax"}], ",", "xMax", ",", "150"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xListSparse", "=", 
     RowBox[{"Subdivide", "[", 
      RowBox[{
       RowBox[{"-", "xMax"}], ",", "xMax", ",", "50"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
