              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"NumericQ", "[", "y", "]"}], ",", 
                RowBox[{"Sow", "[", 
                 RowBox[{"{", 
                  RowBox[{"x", ",", "y"}], "}"}], "]"}]}], "]"}]}], "]"}], 
            ",", "Null"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xListBar"}], "}"}]}], "]"}], "]"}], "[", 
