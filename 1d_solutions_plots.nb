              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"NumericQ", "[", "y", "]"}], "&&", 
                 RowBox[{
                  RowBox[{"-", "xMax"}], "<", "x", "<", 
                  RowBox[{
                   RowBox[{"-", "xMax"}], "+", "10"}]}]}], ",", 
                RowBox[{"Sow", "[", 
                 RowBox[{"{", 
                  RowBox[{"x", ",", "y"}], "}"}], "]"}]}], "]"}]}], "]"}], 
            ",", "Null"}], "]"}], "]"}], ",", 
