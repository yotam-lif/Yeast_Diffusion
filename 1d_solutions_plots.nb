Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Compute", " ", "solution", " ", "values"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"solutionList", "=", 
     RowBox[{
      RowBox[{"Reap", "[", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Quiet", "[", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"y", "=", 
                RowBox[{
                 RowBox[{"solution", "[", 
                  RowBox[{"x", ",", "0"}], "]"}], "-", "0.003"}]}], "}"}], 
              ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"NumericQ", "[", "y", "]"}], ",", 
                RowBox[{"Sow", "[", 
                 RowBox[{"{", 
                  RowBox[{"x", ",", "y"}], "}"}], "]"}]}], "]"}]}], "]"}], 
            ",", "Null"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xList"}], "}"}]}], "]"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "CAnalytical", " ", "values"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CAnalyticalList", "=", 
     RowBox[{
      RowBox[{"Reap", "[", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Quiet", "[", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"y", "=", 
                RowBox[{"CAnalytical", "[", "x", "]"}]}], "}"}], ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"NumericQ", "[", "y", "]"}], ",", 
                RowBox[{"Sow", "[", 
                 RowBox[{"{", 
                  RowBox[{"x", ",", "y"}], "}"}], "]"}]}], "]"}]}], "]"}], 
